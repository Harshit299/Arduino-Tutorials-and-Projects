#define FRAME_COUNT (sizeof(epd_bitmap_allArray) / sizeof(epd_bitmap_allArray[0]))

void setup() {
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_I2C_ADDR)) {
    for(;;); // Don't proceed, loop forever if display fails
  }
  display.clearDisplay();
}

int frame = 0;
void loop() {
  display.clearDisplay();
  // Changed (48, 16) to (0, 0) for full screen bitmap
  // Changed "frames" to "epd_bitmap_allArray"
  display.drawBitmap(0, 0, epd_bitmap_allArray[frame], FRAME_WIDTH, FRAME_HEIGHT, SSD1306_WHITE);
  display.display();
  
  frame = (frame + 1) % FRAME_COUNT;
  delay(FRAME_DELAY);
}